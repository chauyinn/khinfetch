{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KhinFetch",
  "version": "0.1.1",
  "identifier": "com.khinfetch.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KhinFetch",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: https://downloads.khinsider.com https://images.khinsider.com https://vgmtreasurechest.com https://*.vgmtreasurechest.com https://vgmsite.com https://*.vgmsite.com; media-src 'self' https://downloads.khinsider.com https://vgmtreasurechest.com https://*.vgmtreasurechest.com https://vgmsite.com https://*.vgmsite.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFNEMzMUM4NUY5ODA5QkQKUldTOUNaaGZ5REZNdnJRWjEzUWVNVllxZTE5bm9wY0NpV1pzRzdSME82OWFjZHc3bFppMkFhVTIK",
      "endpoints": [
        "https://github.com/chauyinn/khinfetch/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
